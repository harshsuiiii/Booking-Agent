# Copy to .env and fill in real values. Never commit .env.

# Duffel (primary supplier — v1 test mode only; use a duffel_test_* token)
DUFFEL_ACCESS_TOKEN=duffel_test_your_token_here
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
# How long Duffel waits for airline sandboxes (ms). Keep it under the 7 s per-supplier
# timeout: Duffel then returns whatever airlines answered in time (always Duffel Airways).
DUFFEL_SUPPLIER_TIMEOUT_MS=5000
# Set to "true" to allow test bookings (still requires duffel_test_* token in v1)
BOOKING_LIVE_ENABLED=false

# Amadeus (enterprise-only — not implemented in v1; self-service was shut down July 2026)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# LLM for the agent chat. First key found wins: Groq -> Cerebras -> Gemini -> Anthropic.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# gpt-oss models only: low|medium|high. "low" measured ~35% faster on Groq.
LLM_REASONING_EFFORT=low
# Per model call (seconds); one retry on timeout/429/5xx.
LLM_TIMEOUT_S=20
# Whole agent turn (all model + tool calls); the browser gives up after 60s of silence.
AGENT_TURN_TIMEOUT_S=45
AGENT_MAX_TOOL_ROUNDS=3

# Which suppliers run: comma list, or "all" (default). Known: duffel, sim_gds,
# sim_consolidator, sim_ota. Duffel is skipped (never fatal) when off, without a token, or
# when the token isn't a duffel_test_ token; the other suppliers keep working.
SUPPLIERS_ENABLED=all

# Simulated suppliers (real airports/airlines, generated fares; labelled "Simulated data").
SIM_LATENCY_MIN_S=0.2
SIM_LATENCY_MAX_S=1.5
SIM_FAILURE_RATE=0.08
SIM_PRICE_CHANGE_RATE=0.05

# Database. Bookings and recent searches are stored here (run: uv run alembic upgrade head).
# Supabase: Project -> Connect -> Session pooler URI, pasted as given (postgresql://... is fine):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct db.<ref>.supabase.co host is IPv6-only; the pooler works everywhere.
# Local alternatives: SQLite (no server) or empty = in memory.
DATABASE_URL=sqlite+aiosqlite:///./data/booking_agent.db
# Required when DATABASE_URL is set: Fernet key for passenger data at rest. Generate with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
# Use memory:// to run without a Redis server (in-process fakeredis, dev only)

# No login: every visitor is an Agent of the demo agency (sell prices only).
# Demo mode: ~30 seeded demo bookings (only into an empty database) and demo markup.
DEMO_MODE=true
# X-API-Key for scripts (acts as Admin). No default: unset = API-key access disabled.
API_KEY=
API_KEY_TENANT=demo-agency

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
